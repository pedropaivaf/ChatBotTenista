# =============================================================================
# Configuração do LLM de fallback (LM Studio)
# -----------------------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste se necessário. O ".env" NÃO é commitado
# (está no .gitignore). Os testes (run_tests.py) forçam LLM_ENABLED=0 e ignoram
# este arquivo, então rodá-los nunca depende do LM Studio.
# =============================================================================

# Liga (1) ou desliga (0) o fallback LLM. Deixe 1 para a demonstração/vídeo.
LLM_ENABLED=1

# Endpoint do servidor local do LM Studio (API compatível com OpenAI).
LLM_BASE_URL=http://localhost:1234/v1

# Identificador do modelo carregado no LM Studio.
# Recomendado: Qwen/Qwen2.5-7B-Instruct (GGUF). Se a API reclamar do nome,
# use exatamente o id que aparece na aba "Local Server" do LM Studio.
LLM_MODEL=qwen2.5-7b-instruct

# Tempo máximo (s) de espera por resposta do modelo.
LLM_TIMEOUT=30

# Limite de tokens da resposta e temperatura (criatividade).
LLM_MAX_TOKENS=350
LLM_TEMPERATURE=0.5
