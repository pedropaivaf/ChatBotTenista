# =============================================================================
# Configuração do LLM de fallback (LM Studio)
# -----------------------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste se necessário. O ".env" NÃO é commitado
# (está no .gitignore). Os testes (run_tests.py) forçam LLM_ENABLED=0 e ignoram
# este arquivo, então rodá-los nunca depende do LM Studio.
# =============================================================================

# Liga (1) ou desliga (0) o fallback LLM. Deixe 1 para a demonstração/vídeo.
LLM_ENABLED=1

# Endpoint do servidor local do LM Studio (API compatível com OpenAI).
# Use 127.0.0.1 (não "localhost"): no Windows, "localhost" pode resolver para
# IPv6 (::1) e falhar, já que o LM Studio escuta em IPv4 127.0.0.1.
LLM_BASE_URL=http://127.0.0.1:1234/v1

# Identificador do modelo carregado no LM Studio.
# Recomendado: Qwen/Qwen2.5-7B-Instruct (GGUF). Se a API reclamar do nome,
# use exatamente o id que aparece na aba "Local Server" do LM Studio.
LLM_MODEL=qwen2.5-7b-instruct

# Tempo máximo (s) de espera por resposta do modelo.
LLM_TIMEOUT=30

# Limite de tokens da resposta e temperatura (criatividade).
LLM_MAX_TOKENS=350
LLM_TEMPERATURE=0.5

# =============================================================================
# Camada de PESQUISA (retrieval Wikipedia) — "modo pesquisa"
# -----------------------------------------------------------------------------
# Quando a base local não cobre a pergunta, o bot busca o fato na Wikipedia e
# injeta o trecho como grounding do LLM (responde da fonte, não da memória).
# Os testes forçam WEB_SEARCH_ENABLED=0 (sem rede, determinístico).
# =============================================================================

# Liga (1) ou desliga (0) a pesquisa ao vivo na Wikipedia.
WEB_SEARCH_ENABLED=1

# Idioma primário da busca (PT primeiro; cai para EN automaticamente se faltar).
WEB_SEARCH_LANG=pt

# Tempo máximo (s) por requisição à Wikipedia.
WEB_SEARCH_TIMEOUT=8

# Busca web geral (DuckDuckGo, grátis, sem API key) como FALLBACK para fatos específicos/
# atuais que a Wikipedia não traz (ex.: marca da raquete, patrocínios, notícias recentes).
WEB_DDG_ENABLED=1
